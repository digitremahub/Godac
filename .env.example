# ── Clerk (auth, multi-organisation) ─────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Supabase (Postgres + RLS + Storage) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fuel-tickets

# ── Stripe (SaaS billing) ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Resend (transactional email) ─────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL="GODAC <notifications@godac.app>"

# ── Mindee (OCR tickets carburant) ───────────────────────────────
MINDEE_API_KEY=
# Custom Mindee model id if trained; falls back to the generic
# "financial_document" endpoint when empty.
MINDEE_FUEL_MODEL_ID=

# ── Railway (heavy webhooks / OCR job runner) ────────────────────
# Base URL of the Railway worker service, if OCR processing is
# offloaded instead of run in a Next.js API route.
RAILWAY_WORKER_URL=
RAILWAY_WORKER_SECRET=

# ── Pennylane (facturation électronique, non branché) ────────────
# Voir README §"Intégrations non branchées". Laisser vide en MVP.
PENNYLANE_API_KEY=
PENNYLANE_WORKSPACE_ID=

# ── Cron / internal jobs ──────────────────────────────────────────
CRON_SECRET=

# Shared secret for the Supabase Database Webhook that fires on
# `insert on public.alerts` (configured in the Supabase Dashboard,
# see README "Intégrations non branchées" — this one piece of wiring
# cannot be done from a SQL migration).
SUPABASE_DB_WEBHOOK_SECRET=

# ── GODAC operator backoffice (Module 9) ─────────────────────────
# Comma-separated emails allowed into /godac-staff, the cross-tenant
# admin view. Not a Clerk role — deliberately outside the org-scoped
# RLS model entirely.
GODAC_STAFF_EMAILS=
