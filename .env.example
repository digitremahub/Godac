# ── Supabase (Postgres + RLS + Storage + Auth) ───────────────────
# Auth is Supabase's own (passwordless magic-link email) — no
# separate identity provider account needed. Configure the Site URL
# and Redirect URLs under Authentication > URL Configuration in the
# Supabase dashboard to match NEXT_PUBLIC_APP_URL below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fuel-tickets

# ── Stripe (SaaS billing) ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Resend (transactional email) ─────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL="GODAC <notifications@godac.app>"

# ── Anthropic (IA/OCR : import, tickets carburant, compteurs, ────
# rapport de tournée, fiche véhicule, assistant) ─────────────────
# Alimente plusieurs fonctionnalités indépendantes, chacune dégradant
# proprement en son absence (saisie manuelle, ou fonctionnalité
# simplement absente) : fallback IA de l'import véhicules/chauffeurs
# quand le fichier (CSV/Excel) ne suit aucun format de colonnes
# reconnu (lib/import/ai-extract.ts), lecture OCR des tickets
# carburant (lib/ocr/fuel-receipt.ts), lecture OCR des compteurs
# km/totalisateur (lib/ocr/counter.ts), lecture OCR du rapport de
# tournée (lib/ocr/tour-report.ts), fiche véhicule complétée par IA
# (lib/vehicles/ai-specs.ts) et l'assistant d'aide + relais humain
# (lib/assistant/).
ANTHROPIC_API_KEY=

# ── Cron (digest hebdomadaire de planning) ───────────────────────
# Vercel ajoute automatiquement l'en-tête Authorization: Bearer
# <CRON_SECRET> sur ses propres appels vers vercel.json > crons dès
# que cette variable est définie ici. app/api/cron/weekly-planning-
# digest/route.ts refuse de tourner tant qu'elle est vide.
CRON_SECRET=

# ── Railway (heavy webhooks / OCR job runner) ────────────────────
# Base URL of the Railway worker service, if OCR processing is
# offloaded instead of run in a Next.js API route.
RAILWAY_WORKER_URL=
RAILWAY_WORKER_SECRET=

# ── Pennylane (facturation électronique, non branché) ────────────
# Voir README §"Intégrations non branchées". Laisser vide en MVP.
PENNYLANE_API_KEY=
PENNYLANE_WORKSPACE_ID=

# ── Cron / internal jobs ──────────────────────────────────────────
CRON_SECRET=

# Shared secret for the Supabase Database Webhook that fires on
# `insert on public.alerts` (configured in the Supabase Dashboard,
# see README "Intégrations non branchées" — this one piece of wiring
# cannot be done from a SQL migration).
SUPABASE_DB_WEBHOOK_SECRET=

# ── Web push (Module 8, en plus de l'email) ──────────────────────
# Clés VAPID — identifient ce serveur auprès des services de push des
# navigateurs (Chrome/Firefox/Edge). Générées une fois avec
# `node -e "console.log(require('web-push').generateVAPIDKeys())"`,
# jamais régénérées ensuite (ça invaliderait tous les abonnements déjà
# enregistrés). NEXT_PUBLIC_VAPID_PUBLIC_KEY est exposée au client
# (nécessaire pour pushManager.subscribe), VAPID_PRIVATE_KEY ne l'est
# jamais. Laissées vides, le bouton "Activer les notifications" de
# /account échoue proprement — l'email continue de fonctionner seul.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@godac.app

# ── GODAC operator backoffice (Module 9) ─────────────────────────
# Comma-separated emails allowed into /godac-staff, the cross-tenant
# admin view. Not a GODAC role — deliberately outside the org-scoped
# RLS model entirely.
GODAC_STAFF_EMAILS=

# ── GODAC Tournée colis ───────────────────────────────────────────
# Google Places: recherche automatique du nom et des horaires d'ouverture
# des adresses professionnelles lors de l'ajout d'un arrêt (API facturée
# selon l'usage, activer Places API et restreindre la clé côté Google).
# Clé serveur uniquement : ne jamais la préfixer NEXT_PUBLIC_.
# Moteur de routage compatible OSRM pour optimiser selon les distances routières.
# Le service public OSRM est utilisé par défaut ; en production, privilégier
# un service géré ou une instance propre pour la disponibilité et les quotas.
ROUTING_URL=https://router.project-osrm.org

# ── GODAC Tournée colis ───────────────────────────────────────────
# Google Places: recherche automatique du nom et des horaires d'ouverture
# des adresses professionnelles lors de l'ajout d'un arrêt (API facturée
# selon l'usage, activer Places API et restreindre la clé côté Google).
# Clé serveur uniquement : ne jamais la préfixer NEXT_PUBLIC_.
# Moteur de routage compatible OSRM pour optimiser selon les distances routières.
# Le service public OSRM est utilisé par défaut ; en production, privilégier
# un service géré ou une instance propre pour la disponibilité et les quotas.
ROUTING_URL=https://router.project-osrm.org

# Fin de contrat : suppression des données 3 mois après la fin (irréversible).
# Tant que la valeur n est pas exactement "true" : DRY-RUN (journalisation seule, aucun e-mail, aucune suppression).
FIN_CONTRAT_PURGE_ACTIVE=
